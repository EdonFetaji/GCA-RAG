# Copy to .env and fill in. Never commit .env.

# ── LLM ───────────────────────────────────────────────────────────────
# Which registered provider to use: cerebras | groq | gemini | meta | nvidia | mistral
KG_LLM_PROVIDER=cerebras

# Set the key for whichever provider you selected above. Each is read under its
# own vendor-documented name, not a KG_ prefix.
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai/
GROQ_API_KEY=          # https://console.groq.com/keys
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
                       # GOOGLE_API_KEY also works; GEMINI_API_KEY wins if both are set.
META_API_KEY=          # https://developer.meta.com/ai/
                       # Meta documents this as MODEL_API_KEY, which is generic enough to
                       # collide with something else; both work, META_API_KEY wins.
NVIDIA_API_KEY=        # https://build.nvidia.com/ — the key starts with `nvapi-`.
MISTRAL_API_KEY=       # https://console.mistral.ai/api-keys — free "Experiment" mode is
                       # generous on tokens and tight on requests/second, which suits this
                       # pipeline: few calls per cluster, but large ones.

# Model id used by every agent. NOTE: this is shared across providers, so it
# must match the provider you selected — the vendors use different ids.
#   cerebras → gpt-oss-120b
#   groq     → openai/gpt-oss-120b, llama-3.3-70b-versatile, …
#   gemini   → gemini-2.5-flash, gemini-2.5-pro, …
#   meta     → muse-spark-1.2-contributor, muse-spark-1.2, muse-spark-1.1
#   nvidia   → google/gemma-4-31b-it, meta/llama-3.3-70b-instruct, … (vendor-prefixed)
#   mistral  → mistral-large-latest, mistral-medium-latest, magistral-medium-latest, …
#              A `-latest` alias follows whatever snapshot Mistral currently points it at;
#              pin a dated one (mistral-medium-2604) when a run has to stay reproducible.
# They rotate ids on their public endpoints; on a model_not_found 404 check
#   https://inference-docs.cerebras.ai/models/overview
#   https://console.groq.com/docs/models
#   https://developer.meta.com/ai/models/muse-spark/
#   https://build.nvidia.com/models
#   https://docs.mistral.ai/getting-started/models/models_overview/
KG_MODEL=gpt-oss-120b
KG_TEMPERATURE=0.0

# Completion-token cap. Do not leave this unset for Groq: its default is 3072,
# and a reasoning model (openai/gpt-oss-*) spends nearly all of that on internal
# reasoning tokens, leaving none for the answer — the call then fails as
# `json_validate_failed` with an empty `failed_generation`.
KG_MAX_TOKENS=16384

# ── Meta Model API (only read when KG_LLM_PROVIDER=meta) ──────────────
# Muse Spark is a reasoning model, so it has the same trap as gpt-oss above:
# reasoning tokens bill as output and come out of KG_MAX_TOKENS. Keep the
# effort low so the budget goes to the answer, not the scratchpad.
#   minimal | low | medium | high | xhigh   (empty = omit the parameter)
KG_META_REASONING_EFFORT=low
# How structured output is requested: json_schema | function_calling. Meta
# documents tool calling but not the schema mode — switch only if the endpoint
# rejects json_schema, since function_calling puts structured decoding back on
# the tool-call path where truncation surfaces as an opaque parse failure.
KG_META_STRUCTURED_METHOD=json_schema
# Override only for a proxy or gateway.
KG_META_BASE_URL=https://api.meta.ai/v1

# ── Mistral La Plateforme (only read when KG_LLM_PROVIDER=mistral) ────
# How structured output is requested: json_schema | function_calling.
# json_schema is pinned by default — under function_calling the schema rides
# inside a tool call, so a truncated generation fails tool-call parsing with an
# opaque error instead of surfacing as a length problem. The catch: json_schema
# decodes *strictly* (every property required, no additional properties), so if
# a future schema change makes Mistral reject the request, this is the way out.
KG_MISTRAL_STRUCTURED_METHOD=json_schema
# Read timeout for one call, in seconds. Do NOT leave this at the library's own
# default of 120: a 16k-token schema-constrained generation on the free tier runs
# past two minutes, and the timeout surfaces as
#   LLMStructuredOutputError: could not produce a valid KnowledgeGraph:
#   The read operation timed out
# which looks like a schema failure and is not one. Multiplies with retries.
KG_MISTRAL_TIMEOUT_SECONDS=600
# Override only for a proxy, gateway, or self-deployed endpoint.
KG_MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ── NVIDIA NIM (only read when KG_LLM_PROVIDER=nvidia) ────────────────
# Gemma-4-it and similar NIM models gate reasoning behind a chat-template flag.
# Leave it false: reasoning tokens come out of KG_MAX_TOKENS, and a truncated
# generation here does not error — NVIDIA's parser returns nothing at all.
KG_NVIDIA_ENABLE_THINKING=false
# Nucleus sampling. Leave unset (commented out, not blank — a blank fails to
# parse as a number) to omit the parameter, which is right at temperature 0.
# NVIDIA's own Gemma-4 sample pairs temperature 1 with top_p 0.95.
#KG_NVIDIA_TOP_P=0.95
# Point at a self-hosted NIM container instead of the hosted catalog.
KG_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Pipeline behaviour ────────────────────────────────────────────────
# How many extractor↔grader rounds before the loop gives up unconverged.
KG_MAX_ITERATIONS=3
# Which prompt template version the extractor and grader resolve. See
# kg_agentic_extraction/prompts/templates/.
#   v2 (default) — open-vocabulary: the extractor names its own entity and
#                  relation types, and the grader audits them for aptness and
#                  consistency. No ontology is injected at extraction time.
#   v1           — the original ontology-constrained regime, kept so the two can
#                  be compared on the same clusters. See
#                  docs/adr/0004-open-vocabulary-extraction.md.
KG_PROMPT_VERSION=v2

# ── Output & Google Cloud Storage ─────────────────────────────────────
# Where the runner writes each cluster's graph as HDF5.
KG_GRAPH_OUTPUT_DIR=kg_dataset/data
# Bucket the saved .h5 is copied to after it is written locally. Leave empty to
# keep everything on disk — the upload is an extra copy, never the source of
# truth, and a failed one only logs. Name only: no gs:// scheme, no path.
KG_GCS_BUCKET=
# Object-name prefix inside the bucket:
#   KG_GCS_PREFIX=graphs → gs://<bucket>/graphs/cluster_0.h5
KG_GCS_PREFIX=
# Credentials come from Application Default Credentials, not from a KG_ setting:
#   gcloud auth application-default login          (local)
#   GOOGLE_APPLICATION_CREDENTIALS=/path/key.json  (service account)
# and are resolved automatically on GCE / Cloud Run / GKE.
#GOOGLE_APPLICATION_CREDENTIALS=

# ── DBpedia MCP server ────────────────────────────────────────────────
# Where the grounder reaches the standalone MCP service. Start it with:
#   uv run python -m mcp_server.server
# FastMCP mounts streamable-http at /mcp/ — the trailing slash matters.
KG_MCP_URL=http://127.0.0.1:8931/mcp/

# How many tool-calling rounds the grounder gets before it must answer. A round
# can carry several parallel calls, so this budgets reasoning depth, not lookups.
KG_GROUNDING_MAX_TOOL_ROUNDS=8
KG_GROUNDING_TOOL_TIMEOUT_SECONDS=30

# The grounder pins its own prompt generation: it became a tool-calling agent in
# v2 while the extractor and grader stayed on v1.
KG_GROUNDER_PROMPT_VERSION=v2

# ── DBpedia endpoints (read by the MCP server, not the pipeline) ──────
DBPEDIA_SPARQL_ENDPOINT=https://dbpedia.org/sparql
DBPEDIA_LOOKUP_ENDPOINT=https://lookup.dbpedia.org/api/search
# The public Spotlight instance is frequently unreachable. spotlight_link
# degrades to a note when it is, but a local container makes it reliable:
#   docker run -p 2222:80 dbpedia/dbpedia-spotlight spotlight.sh en
#   DBPEDIA_SPOTLIGHT_ENDPOINT=http://localhost:2222/rest
DBPEDIA_SPOTLIGHT_ENDPOINT=https://api.dbpedia-spotlight.org/en

# Cached for this long so a grounding pass is not rate-limited partway through.
DBPEDIA_CACHE_TTL_SECONDS=900

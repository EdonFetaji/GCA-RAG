# Copy to `.env` and fill in. Every setting the pipeline reads is listed here;
# the authoritative descriptions live on the fields in
# `kg_agentic_extraction/config.py`.
#
# Two naming conventions coexist, on purpose:
#   - Provider API keys use their un-prefixed, vendor-documented names
#     (GEMINI_API_KEY, MISTRAL_API_KEY, ...) so a key already exported in your
#     shell works without being renamed.
#   - Everything else is KG_-prefixed, matching `PipelineSettings`' env_prefix.

# ══════════════════════════════════════════════════════════════════════
# 1. Single-run providers  (runner.py — one cluster at a time)
# ══════════════════════════════════════════════════════════════════════

# The fallback provider/model pair. Any agent whose role is not bound below
# uses this one. Registered providers: cerebras, groq, gemini, meta, nvidia,
# mistral (see llm/factory.py).
KG_LLM_PROVIDER=gemini
KG_MODEL=gemini-2.5-flash

# Completion-token cap. Set it explicitly — the note on `max_tokens` in
# config.py explains what a reasoning model does to an unset one.
KG_MAX_TOKENS=16384
KG_TEMPERATURE=0.0

GEMINI_API_KEY=
# Extra Gemini keys for rotation in a single-process run. Comma-, space- or
# newline-separated. In batch mode this is ignored — each worker gets its own
# bundle from section 3 instead.
GEMINI_API_KEYS=
MISTRAL_API_KEY=

# Other providers, unused unless KG_LLM_PROVIDER names them.
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# META_API_KEY=

# ══════════════════════════════════════════════════════════════════════
# 2. Per-agent provider binding
# ══════════════════════════════════════════════════════════════════════
# The extractor and the grader are different workloads, so they run on
# different vendors. The extractor sends the documents and gets a whole graph
# back on every repair round — that is where the tokens go, and why it holds two
# rotating Gemini keys. The grader reads that graph once and answers with prose,
# which one Mistral key covers.
#
# Leave a pair empty to fall back to KG_LLM_PROVIDER / KG_MODEL above.

KG_EXTRACTOR_PROVIDER=gemini
KG_EXTRACTOR_MODEL=gemini-3.6-flash
KG_GRADER_PROVIDER=mistral
KG_GRADER_MODEL=mistral-medium-latest
    
# ══════════════════════════════════════════════════════════════════════
# 3. Batch mode  (python -m kg_agentic_extraction.batch)
# ══════════════════════════════════════════════════════════════════════

# Inclusive Multi-News test-split cluster range. `--range START END` overrides.
KG_CLUSTER_START=0
KG_CLUSTER_END=199

# Worker *processes*, one per core, each running a single-threaded pipeline.
# Capped at the number of key bundles below — a worker without its own keys
# would have to borrow, which is exactly what this design prevents.
KG_MAX_WORKERS=4

# ── Per-worker key bundles ────────────────────────────────────────────
# Two Gemini keys (extractor, rotated on quota) and one Mistral key (grader)
# per worker, owned exclusively. No key may appear in two bundles: the whole
# reason batch mode uses processes rather than threads is that a key spent by
# one worker must stay usable by the others.
#
# Add a fifth worker by adding KG_WORKER_4_* and raising KG_MAX_WORKERS — the
# bundles are scanned from the environment, so no code change is needed.

KG_WORKER_0_GEMINI_KEYS=
KG_WORKER_0_MISTRAL_KEY=

KG_WORKER_1_GEMINI_KEYS=
KG_WORKER_1_MISTRAL_KEY=

KG_WORKER_2_GEMINI_KEYS=
KG_WORKER_2_MISTRAL_KEY=

KG_WORKER_3_GEMINI_KEYS=
KG_WORKER_3_MISTRAL_KEY=

# ══════════════════════════════════════════════════════════════════════
# 4. Loop, prompts, extraction scope
# ══════════════════════════════════════════════════════════════════════

# Extractor↔grader rounds before the loop stops unconverged (3–10).
KG_MAX_ITERATIONS=6

# Extractor template generation; see prompts/templates/extractor/.
KG_PROMPT_VERSION=v3
# Grader templates, versioned separately. v4 is where the grader stopped
# emitting typed issues and started writing its own Markdown — the schema moved
# with it (GraderReport → MistralGraderReport), so the two must change together.
KG_GRADER_PROMPT_VERSION=v4
# Grounder templates, versioned separately again (it became tool-calling in v2).
KG_GROUNDER_PROMPT_VERSION=v2

# Documents fed to the extractor from one cluster.
KG_MAX_DOCUMENTS=10

# ══════════════════════════════════════════════════════════════════════
# 5. Grounding  (runner.py only — batch mode forces this off)
# ══════════════════════════════════════════════════════════════════════

KG_GROUNDING_ENABLED=true
# FastMCP mounts the DBpedia server at /mcp/ — the trailing slash matters.
KG_MCP_URL=http://127.0.0.1:8931/mcp/
KG_GROUNDING_MAX_TOOL_ROUNDS=8
KG_GROUNDING_TOOL_TIMEOUT_SECONDS=30

# ══════════════════════════════════════════════════════════════════════
# 6. Output
# ══════════════════════════════════════════════════════════════════════

KG_GRAPH_OUTPUT_DIR=kg_dataset/data

# Bucket the saved .h5 is copied to. Empty disables the upload. Name only —
# no gs:// scheme, no path. Credentials come from Application Default
# Credentials (`gcloud auth application-default login`, or the VM's attached
# service account). When set, this is also where batch mode reads its resume
# state from: the bucket, not the local disk of an ephemeral VM.
KG_GCS_BUCKET=
KG_GCS_PREFIX=

# ══════════════════════════════════════════════════════════════════════
# 7. Provider-specific knobs  (inert unless that provider is in use)
# ══════════════════════════════════════════════════════════════════════

# Mistral: ChatMistralAI defaults to a 120s read timeout, which a 16k-token
# schema-constrained generation on the free tier overruns. The failure then
# arrives looking like a schema error and is not one.
KG_MISTRAL_TIMEOUT_SECONDS=600
KG_MISTRAL_STRUCTURED_METHOD=json_schema
# KG_MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Meta: reasoning tokens bill as output and come out of KG_MAX_TOKENS.
# KG_META_REASONING_EFFORT=low
# KG_META_STRUCTURED_METHOD=json_schema
# KG_META_BASE_URL=https://api.meta.ai/v1

# NVIDIA NIM.
# KG_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# KG_NVIDIA_TOP_P=
# KG_NVIDIA_ENABLE_THINKING=false
